# Secrets for the VLR Daily Digest Bot.
# Copy this file to `.env` and fill in your values. NEVER commit the real `.env`.

# Telegram (required)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Gemini (optional — falls back to heuristic ranking if missing)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Tuning (optional)
DIGEST_DAYS_AHEAD=2
DIGEST_MAX_MATCHES=40
