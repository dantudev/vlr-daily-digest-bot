# Secrets for the VLR Daily Digest Bot.
# Copy this file to `.env` and fill in your values. NEVER commit the real `.env`.

# Telegram (required)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Gemini (optional — falls back to heuristic ranking if missing)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Tuning (optional)
# Hour (CEST) the digest "day" starts/ends: matches from 09:00 today to 09:00 tomorrow.
DIGEST_DAY_START_HOUR=9
DIGEST_MAX_MATCHES=60
